# Vane Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# External port (host side). Internal container port is 3000.
VANE_PORT=3004

# Timezone
TZ=Asia/Jakarta

# --- Slim variant only (full bundle ignores this) ---
# URL to an existing SearXNG instance. The instance must expose JSON format
# and have the Wolfram Alpha engine enabled.
# SEARXNG_API_URL=http://searxng:8080
