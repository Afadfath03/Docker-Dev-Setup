# ExcaliDash Environment Configuration
# Copy to .env and adjust values before running docker compose up

# --- Security (WAJIB ganti) ---
# Minimal 32 karakter, random. Jangan dikosongkan.
# Jika kosong -> backend auto-generate & persist di volume (ok untuk single-instance)
# Jika pakai placeholder -> session bisa dibajak
JWT_SECRET=change-me-to-long-random-string-at-least-32-chars

# Minimal 32 karakter, random. Harus berbeda dari JWT_SECRET.
CSRF_SECRET=change-me-to-another-long-random-string-at-least-32

# --- Authentication ---
# local | hybrid | oidc_enforced
# local = register/login via form di UI
# hybrid = local + OIDC
# oidc_enforced = hanya bisa login via OIDC
AUTH_MODE=local

# --- Reverse Proxy ---
# Set TRUST_PROXY=1 jika di belakang NPM / reverse proxy lain yang tepercaya
# TRUST_PROXY=false

# --- OIDC (untuk hybrid/oidc_enforced) ---
# OIDC_PROVIDER_NAME=Authentik
# OIDC_ISSUER_URL=https://auth.example.com/application/o/excalidash/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://excalidash.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
