# Embedding model (optional — dramatically improves search quality)
# Format: "provider:model_name" or just "model_name" for OpenAI default
# Examples: openai:text-embedding-3-small, gemini:gemini-embedding-exp-03-07
DOCS_MCP_EMBEDDING_MODEL=

# OpenAI (default embedding provider)
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_API_BASE=

# Google Gemini (alternative embedding provider)
GOOGLE_API_KEY=

# Disable analytics (leave empty to disable)
POSTHOG_API_KEY=
