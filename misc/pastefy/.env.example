# Pastefy Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# --- Database (WAJIB ganti) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-pastefy-password
# MYSQL_DATABASE=pastefy
# MYSQL_USER=pastefy

# --- Server ---
# URL publik instance (penting untuk OAuth redirect)
SERVER_NAME=http://localhost:9999

# --- CORS ---
# HTTP_SERVER_CORS=*

# --- OAuth2 (opsional) ---
# Set CLIENT_ID ke NONE untuk menonaktifkan provider
# OAUTH2_GITHUB_CLIENT_ID=NONE
# OAUTH2_GITHUB_CLIENT_SECRET=
# OAUTH2_GOOGLE_CLIENT_ID=NONE
# OAUTH2_GOOGLE_CLIENT_SECRET=
# OAUTH2_DISCORD_CLIENT_ID=NONE
# OAUTH2_DISCORD_CLIENT_SECRET=
# OAUTH2_TWITCH_CLIENT_ID=NONE
# OAUTH2_TWITCH_CLIENT_SECRET=
