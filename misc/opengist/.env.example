# OpenGist Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# --- Wajib diisi ---
OG_EXTERNAL_URL=https://opengist.domain.com
OG_SECRET_KEY=change-me-to-random-64-hex-chars

# --- User/group ID untuk file ownership (default: 1000) ---
# UID=1000
# GID=1000

# --- OAuth2 (opsional) ---
# OG_GITHUB_CLIENT_KEY=
# OG_GITHUB_SECRET=
# OG_GITLAB_CLIENT_KEY=
# OG_GITLAB_SECRET=
# OG_GITEA_CLIENT_KEY=
# OG_GITEA_SECRET=
# OG_OIDC_PROVIDER_NAME=
# OG_OIDC_CLIENT_KEY=
# OG_OIDC_SECRET=
# OG_OIDC_DISCOVERY_URL=
