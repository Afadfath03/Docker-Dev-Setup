# SearXNG Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

PORT=8443

# Change this to your public URL (e.g. https://search.example.com)
SEARXNG_BASE_URL=http://localhost:8443

# Generate with: openssl rand -hex 32
# If left empty, a new secret is generated on every restart (sessions invalidated)
SEARXNG_SECRET=change-me-to-long-random-hex-string
