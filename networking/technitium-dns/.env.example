# Technitium DNS Server Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# --- Wajib diisi (WAJIB ganti) ---
# Password untuk web admin console (http://<ip>:5380), user: admin
DNS_SERVER_ADMIN_PASSWORD=ganti-password-ini

# --- Optional ---
# Zona waktu
TZ=Asia/Jakarta

# Domain name server ini (identitas DNS server)
# DNS_SERVER_DOMAIN=technitium-dns

# Upstream forwarder (dipisah koma)
# DNS_SERVER_FORWARDERS=1.1.1.1,8.8.8.8
