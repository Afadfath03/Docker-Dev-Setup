# Pi-hole Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# --- Wajib diisi (WAJIB ganti) ---
# Zona waktu
TZ=Asia/Jakarta

# Password untuk web admin panel (http://<ip>:8089/admin)
# Jika dikosongkan, Pi-hole akan generate random password (cek log container)
FTLCONF_WEBSERVER_API_PASSWORD=ganti-password-ini

# --- Optional ---
# Upstream DNS server (dipisah dengan titik koma)
# Default: Cloudflare (primary) + Cloudflare (secondary)
PIHOLE_DNS_=1.1.1.1;1.0.0.1
