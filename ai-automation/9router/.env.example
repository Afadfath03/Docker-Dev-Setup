# 9Router Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# --- Security (WAJIB ganti) ---
# Jika dibiarkan kosong -> app auto-generate tiap restart, session kadaluarsa setelah restart
# Jika dibiarkan placeholder -> secret bisa ditebak, session bisa dibajak
JWT_SECRET=change-me-to-long-random-string

# Jika dibiarkan kosong -> app mungkin gagal startup (tidak ada fallback)
# Jika dibiarkan placeholder -> siapapun bisa login dengan password ini
INITIAL_PASSWORD=ganti-password-default

# Jika dibiarkan kosong -> HMAC key kosong, API key tidak valid
# Jika dibiarkan placeholder -> API key bisa dipalsukan
API_KEY_SECRET=change-this-secret-too

# --- Optional ---
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
DATA_DIR=/app/data
REQUIRE_API_KEY=false
MACHINE_ID_SALT=endpoint-proxy-salt
AUTH_COOKIE_SECURE=false
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
ENABLE_REQUEST_LOGS=false
