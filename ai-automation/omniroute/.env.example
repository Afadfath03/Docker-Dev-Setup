# OmniRoute Environment Configuration
# Copy this file to .env and adjust values before running docker compose up
#
# Generate required secrets:
#   echo "JWT_SECRET=$(openssl rand -base64 48)"
#   echo "API_KEY_SECRET=$(openssl rand -hex 32)"
#   echo "INITIAL_PASSWORD=$(openssl rand -base64 16)"
#   echo "OMNIROUTE_WS_BRIDGE_SECRET=$(openssl rand -base64 32)"

# --- Security (WAJIB ganti) ---
# JWT signing key for dashboard session tokens
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-base64-random-string

# Encryption key for API keys stored in the database
# Generate: openssl rand -hex 32
API_KEY_SECRET=change-me-to-hex-random-string

# Initial admin login password — ganti segera setelah login pertama
# Default: CHANGEME (insecure, hanya untuk dev)
INITIAL_PASSWORD=ganti-ini-sekarang

# Shared secret untuk WebSocket bridge — WAJIB diisi di production
# Jika kosong, semua WS bridge request ditolak
# Generate: openssl rand -base64 32
OMNIROUTE_WS_BRIDGE_SECRET=change-me-too

# --- Port ---
# Port 20128 sudah dipakai 9router — omniroute default ke 20130
PORT=20130

# --- Redis ---
# Redis connection URL (default: redis://redis:6379 untuk sidecar container)
REDIS_URL=redis://redis:6379

# --- NPM Reverse Proxy ---
# Ganti dengan domain NPM kamu
NEXT_PUBLIC_BASE_URL=https://omniroute.example.com

# Internal URL (container-to-container)
BASE_URL=http://omniroute:20130

# Set true karena di belakang HTTPS (NPM)
AUTH_COOKIE_SECURE=true

# --- Optional ---
NODE_ENV=production
REQUIRE_API_KEY=false
OMNIROUTE_MEMORY_MB=512
ENABLE_REQUEST_LOGS=false
