# Open WebUI Environment Configuration
# Copy this file to .env and adjust values before running docker compose up

# --- Security (WAJIB ganti untuk production) ---
# Auto-generate jika dikosongkan, tapi session akan kadaluarsa setelah restart
WEBUI_SECRET_KEY=change-me-to-long-random-hex-string

# --- URL ---
# Set ke domain NPM untuk OAuth/SSO & callback; default http://localhost:3002
WEBUI_URL=http://localhost:3002

# --- Optional: Ollama ---
# Biarkan kosong jika tidak menggunakan Ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Optional: OpenAI-compatible API ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# --- Optional: Auth ---
# ENABLE_SIGNUP=true
# DEFAULT_USER_ROLE=user   # pending | user | admin

# --- Optional: Timezone ---
TZ=Asia/Jakarta
